LIBERO_REMOTE_PUBLIC_PORT=8000
LIBERO_REMOTE_MAX_SESSIONS=1
LIBERO_REMOTE_WORKER_TIMEOUT_SECONDS=120
LIBERO_REMOTE_SESSION_IDLE_TIMEOUT_SECONDS=900
LIBERO_REMOTE_CLEANUP_INTERVAL_SECONDS=30
LIBERO_REMOTE_SCHEDULER_QUEUE_CAPACITY=4096
LIBERO_REMOTE_MAX_ACTIVE_SESSIONS_PER_OWNER=1
LIBERO_REMOTE_HEARTBEAT_INTERVAL_SECONDS=15
LIBERO_REMOTE_LEASE_GRACE_PERIOD_SECONDS=60
LIBERO_REMOTE_CLAIM_INTENT_TTL_SECONDS=30
# Set false after every runner has migrated to /v1/runs and leases.
LIBERO_REMOTE_ALLOW_DIRECT_SESSIONS=true
LIBERO_REMOTE_LOG_LEVEL=info
LIBERO_REMOTE_IMAGE_TAG=local
# The container uses assets/bddl/00_original/bddl for base tasks.
NVIDIA_VISIBLE_DEVICES=all

# Keep the simulator revision fixed for reproducible results.
LIBERO_PRO_REPOSITORY=https://github.com/Zxy-MLlab/LIBERO-PRO.git
LIBERO_PRO_COMMIT=eafdb809426b13153aa1e4c42d6601844217dfec
