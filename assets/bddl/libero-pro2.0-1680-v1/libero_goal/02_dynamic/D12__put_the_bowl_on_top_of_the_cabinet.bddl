    wooden_cabinet_1 - wooden_cabinet
    flat_stove_1 - flat_stove
    wine_rack_1 - wine_rack
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    wine_bottle_1 - wine_bottle
    plate_1 - plate
  )

  (:obj_of_interest
    akita_black_bowl_1
    wooden_cabinet_1_top_side
  )

  (:init
    (On wine_bottle_1 main_table_wine_bottle_region)
    (On akita_black_bowl_1 main_table_akita_black_bowl_region)
    (On plate_1 main_table_plate_region)
    (On cream_cheese_1 main_table_cream_cheese_region)
    (On wooden_cabinet_1 main_table_cabinet_region)
    (On flat_stove_1 main_table_stove_region)
    (On wine_rack_1 main_table_wine_rack_region)
  )

  (:goal
    (And (On akita_black_bowl_1 wooden_cabinet_1_top_side))
  )

  (:perturbation_config
    (:schema_version 4)
    (:profile nonphysical_shared_operator_schema)
    (:source_suite libero_goal)
    (:source_task put_the_bowl_on_top_of_the_cabinet)
    (:configuration_mode shared_operator_instances)
    (:active_cases D12)
    (:case_id D12)
    (:case_kind dynamic)
    (:excluded_domains mass friction force stiffness damping collision_impulse)
    (:schema_status base_capability_catalog)

    (:case_defaults
      (:enable_rule listed_in_active_cases)
      (:unlisted_cases disabled)
      (:schedule_rule S_static_D_dynamic)
      (:base_constraints goal_unchanged collision_free task_completable)
      (:runtime_rule selected_operator_and_schedule)
    )

    (:schedule_catalog
      (static (:start reset) (:duration episode) (:restore false))
      (dynamic (:start event_trigger) (:duration case_defined) (:restore case_defined))
    )

    (:perturbations
