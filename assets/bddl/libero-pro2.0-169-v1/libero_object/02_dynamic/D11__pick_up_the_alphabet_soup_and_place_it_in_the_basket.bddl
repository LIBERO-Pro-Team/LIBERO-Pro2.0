(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet soup and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_1 - basket
    salad_dressing_1 - salad_dressing
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    tomato_sauce_1 - tomato_sauce
    butter_1 - butter
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_1
  )

  (:init
    (On alphabet_soup_1 floor_target_object_region)
    (On salad_dressing_1 floor_other_object_region_0)
    (On cream_cheese_1 floor_other_object_region_1)
    (On milk_1 floor_other_object_region_2)
    (On tomato_sauce_1 floor_other_object_region_3)
    (On butter_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region))
  )

  (:perturbation_config
    (:schema_version 4)
    (:profile nonphysical_shared_operator_schema)
    (:source_suite libero_object)
    (:source_task pick_up_the_alphabet_soup_and_place_it_in_the_basket)
    (:configuration_mode shared_operator_instances)
    (:active_cases D11)
    (:case_id D11)
    (:case_kind dynamic)
    (:excluded_domains mass friction force stiffness damping collision_impulse)
    (:schema_status single_active_case)

    (:case_defaults
      (:enable_rule listed_in_active_cases)
      (:unlisted_cases disabled)
      (:schedule_rule S_static_D_dynamic)
      (:base_constraints goal_unchanged collision_free task_completable)
      (:runtime_rule selected_operator_and_schedule)
    )

    (:schedule_catalog
      (static
        (:start reset)
        (:duration episode)
        (:restore false)
      )
      (dynamic
        (:start event_trigger)
        (:duration case_defined)
        (:restore case_defined)
      )
    )

    (:operator_catalog
      (pose_transform
        (:adapter pose_transform_adapter)
        (:execution reset_or_runtime_by_schedule)
      )
      (geometry_variant
        (:adapter geometry_asset_adapter)
        (:execution reset_model_build)
      )
      (asset_or_appearance
        (:adapter asset_appearance_adapter)
        (:execution reset_scene_build)
      )
      (occlusion_or_obstacle
        (:adapter scene_object_adapter)
        (:execution reset_or_runtime_by_schedule)
      )
      (camera_transform
        (:adapter camera_adapter)
        (:execution reset_or_runtime_by_schedule)
      )
      (observation_fault
        (:adapter observation_wrapper)
        (:execution observation_pipeline)
      )
      (timing_or_action_fault
        (:adapter control_transport_wrapper)
        (:execution rollout_pipeline)
      )
      (state_or_language_event
        (:adapter state_language_adapter)
        (:execution reset_or_runtime_by_schedule)
      )
    )

    (:object_placement
      (:legacy_adapter true)
      (:enabled false)
      (:case S12)
      (:mode front_occlusion)
      (:reference alphabet_soup_1)
      (:front_direction 1.0 0.0)
      (:avoid_targets basket_1)
      (:min_avoid_distance 0.08)
      (:targets milk_1)
      (:offsets_xy (
        (0.080 0.000)
      ))
      (:target_quat 1.0 0.0 0.0 0.0)
      (:z_offset 0.000)
      (:mesh_scale 1.6 1.6 1.6)
      (:min_reference_distance 0.02)
      (:pin_targets true)
    )

    (:perturbations
      (S01
        (:operator pose_transform)
        (:targets alphabet_soup_1)
        (:variant xy_yaw)
      )
      (S02
        (:operator pose_transform)
        (:targets basket_1)
        (:variant xy_yaw)
      )
      (S03
        (:operator geometry_variant)
        (:targets basket_1 floor)
        (:variant receiver_or_support_height)
      )
      (S04
        (:operator pose_transform)
        (:targets alphabet_soup_1 milk_1)
        (:variant planar_object_position_swap)
        (:constraints same_support_surface collision_free task_completable)
      )
      (S05
        (:operator geometry_variant)
        (:targets alphabet_soup_1 basket_1)
        (:references milk_1)
        (:variant restricted_approach_or_path)
        (:constraints initial_collision_free ik_reachable full_path_exists)
      )
      (S06
        (:operator asset_or_appearance)
        (:targets alphabet_soup_1)
        (:variant same_class_or_unseen_instance)
      )
      (S07
        (:operator geometry_variant)
        (:targets basket_1)
        (:parts opening rim contain_region)
        (:variant functional_part_geometry)
      )
      (S08
        (:operator geometry_variant)
        (:targets alphabet_soup_1)
        (:variant scale_or_aspect_ratio)
      )
      (S09
        (:operator geometry_variant)
        (:targets alphabet_soup_1 basket_1)
        (:variant container_opening_clearance_and_pose_coupling)
        (:constraints real_collision_geometry full_containment positive_clearance insertion_depth)
      )
      (S10
        (:operator asset_or_appearance)
        (:targets tomato_sauce_1 milk_1)
        (:variant irrelevant_object_clutter)
      )
      (S11
        (:operator asset_or_appearance)
        (:targets alphabet_soup_1)
        (:references tomato_sauce_1)
        (:variant same_class_or_visually_similar_distractor)
      )
      (S12
        (:operator occlusion_or_obstacle)
        (:targets alphabet_soup_1 basket_1)
        (:references milk_1 agentview)
        (:variant persistent_front_occlusion)
        (:params
          (:front_direction 1.0 0.0)
          (:offset_xy 0.080 0.000)
          (:mesh_scale 1.6 1.6 1.6)
          (:pin true)
        )
      )
      (S13
        (:operator asset_or_appearance)
        (:targets alphabet_soup_1 basket_1)
        (:variant color_texture_reflection_or_surface_state)
      )
      (S14
        (:operator asset_or_appearance)
        (:targets floor alphabet_soup_1)
        (:variant foreground_background_contrast_or_scene_domain)
      )
      (S15
        (:operator camera_transform)
        (:targets agentview robot0_eye_in_hand)
        (:variant fixed_extrinsics_or_cross_camera_calibration)
      )
      (S16
        (:operator camera_transform)
        (:targets agentview robot0_eye_in_hand)
        (:variant intrinsics_fov_resolution_crop_or_distortion)
      )
      (S17
        (:operator state_or_language_event)
        (:targets robot0)
        (:variant initial_joints_eef_orientation_or_gripper_opening)
      )
      (S18
        (:operator state_or_language_event)
        (:targets robot0)
        (:variant base_tcp_joint_zero_or_grasp_center_calibration)
      )
      (S19
        (:operator observation_fault)
        (:targets rgb depth)
        (:variant compression_noise_blur_exposure_contamination_or_depth_holes)
      )
      (S20
        (:operator timing_or_action_fault)
        (:targets observation inference control action)
        (:variant fixed_rate_delay_or_action_window)
      )
      (S21
        (:operator state_or_language_event)
        (:targets task_instruction)
        (:variant semantic_paraphrase)
        (:params
          (:source pick_the_alphabet_soup_and_place_it_in_the_basket)
          (:value put_the_alphabet_soup_into_the_basket)
        )
        (:constraints semantic_goal_unchanged)
      )

      (D01
        (:operator pose_transform)
        (:targets alphabet_soup_1)
        (:trigger approach_or_pregrasp)
        (:variant xy_yaw_update)
      )
      (D02
        (:operator pose_transform)
        (:targets basket_1)
        (:trigger postgrasp_or_preplace)
        (:variant xy_yaw_update)
      )
      (D03
        (:operator occlusion_or_obstacle)
        (:targets basket_1)
        (:references tomato_sauce_1)
        (:trigger preplace)
        (:variant occupy_or_release_receiver)
      )
      (D04
        (:operator occlusion_or_obstacle)
        (:targets alphabet_soup_1 basket_1)
        (:references milk_1)
        (:trigger task_phase)
        (:variant enter_hold_exit_occlusion)
      )
      (D05
        (:operator occlusion_or_obstacle)
        (:targets robot_future_path)
        (:references milk_1)
        (:trigger transport)
        (:variant obstacle_enters_path)
        (:constraints alternate_collision_free_path_exists)
      )
      (D06
        (:operator pose_transform)
        (:targets tomato_sauce_1 milk_1)
        (:trigger task_phase)
        (:variant distractor_move_or_local_rearrangement)
      )
      (D07
        (:operator camera_transform)
        (:targets agentview robot0_eye_in_hand)
        (:trigger task_phase)
        (:variant shake_drift_or_persistent_offset)
      )
      (D08
        (:operator observation_fault)
        (:targets agentview robot0_eye_in_hand)
        (:trigger task_phase)
        (:variant camera_dropout_then_restore)
      )
      (D09
        (:operator observation_fault)
        (:targets rgb)
        (:trigger task_phase)
        (:variant light_shadow_or_exposure_change)
      )
      (D10
        (:operator observation_fault)
        (:targets rgb depth)
        (:trigger task_phase)
        (:variant drop_repeat_or_freeze_frames)
      )
      (D11
        (:operator observation_fault)
        (:targets agentview robot0_eye_in_hand depth proprioception)
        (:trigger task_phase)
        (:variant timestamp_offset_or_state_freeze)
      )
      (D12
        (:operator timing_or_action_fault)
        (:targets observation inference)
        (:trigger task_phase)
        (:variant transient_latency_spike)
      )
      (D13
        (:operator timing_or_action_fault)
        (:targets arm gripper)
        (:trigger task_phase)
        (:variant delay_jitter_or_desynchronization)
      )
      (D14
        (:operator timing_or_action_fault)
        (:targets action)
        (:trigger task_phase)
        (:variant command_drop_or_repeat)
      )
      (D15
        (:operator timing_or_action_fault)
        (:targets action_chunk replan)
        (:trigger state_change)
        (:variant stale_chunk_late_chunk_or_replan_interrupt)
        (:policy_gate action_chunk_capable)
      )
      (D16
        (:operator state_or_language_event)
        (:targets robot0)
        (:trigger task_phase)
        (:variant bounded_action_takeover_or_reachable_state_offset)
        (:constraints no_physical_contact)
      )
      (D17
        (:operator state_or_language_event)
        (:targets alphabet_soup_1 gripper)
        (:trigger grasp_attempt)
        (:variant grasp_failure_result)
        (:constraints retry_remains_possible)
      )
      (D18
        (:operator state_or_language_event)
        (:targets alphabet_soup_1)
        (:trigger transport)
        (:variant reachable_collision_free_drop_state)
        (:constraints recovery_remains_possible)
      )
      (D19
        (:operator state_or_language_event)
        (:targets alphabet_soup_1 basket_1)
        (:trigger place_attempt)
        (:variant misplace_partial_insert_or_wrong_receiver_result)
        (:constraints correction_remains_possible)
      )
      (D20
        (:operator state_or_language_event)
        (:targets alphabet_soup_1 basket_1)
        (:trigger partial_success_or_safe_stop)
        (:variant interrupt_regress_then_continue)
        (:constraints delayed_termination recovery_window)
      )
      (D21
        (:operator state_or_language_event)
        (:targets task_instruction)
        (:trigger task_phase)
        (:variant equivalent_restatement_or_clarification)
        (:policy_gate runtime_instruction_update_capable)
        (:constraints semantic_goal_unchanged)
      )
    )
  )
)
